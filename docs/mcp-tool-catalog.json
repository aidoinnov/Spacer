    {
      "name": "query_nodes",
      "description": "Search files using the original SpaceSniffer filter grammar (; OR masks, size/time/tag/folder conditions). Each page examines at most budget nodes; an empty page may still have next_offset.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "integer",
            "description": "App process ID from app_instances.",
