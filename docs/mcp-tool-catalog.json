          "revision": {
            "type": "string",
            "description": "Pin pagination to snapshot_revision."
          },
          "path": {
            "type": "string",
            "description": "Absolute path in the scanned snapshot. Omit to use the focused folder.",
            "maxLength": 4096
          },
          "expression": {
            "type": "string",
            "description": "Native filter expression.",
            "maxLength": 4096
          },
          "budget": {
            "type": "integer",
            "description": "Snapshot mode: node inspections. Subtree mode: total node/edge/unwind traversal steps.",
            "minimum": 1,
            "maximum": 100000,
            "default": 50000
          },
          "traversal": {
            "type": "string",
            "description": "snapshot preserves global array offsets; subtree uses bounded one-use server cursors.",
            "enum": [
              "snapshot",
              "subtree"
            ],
            "default": "snapshot"
          },
          "cursor": {
            "type": "string",
            "description": "Opaque next_cursor from the previous subtree page. Consumed on a successful page; do not blindly retry.",
            "maxLength": 36
          },
          "cancel_cursor": {
            "type": "boolean",
            "description": "Cancel and release a subtree cursor; requires traversal=subtree and cursor.",
            "default": false
          }
        },
        "required": [],
