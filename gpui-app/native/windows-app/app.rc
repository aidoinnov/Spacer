#include <windows.h>
1 ICON "AppIcon.ico"
// The pinned GPUI dependency owns RT_MANIFEST(1): asInvoker, PerMonitorV2,
// Windows 10 compatibility and Common Controls. A second owner breaks linking.
1 VERSIONINFO
 FILEVERSION 0,3,0,0
 PRODUCTVERSION 0,3,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Space Sniffer GPUI\0"
   VALUE "FileVersion", "0.3.0.0\0"
   VALUE "ProductName", "Mac Space Sniffer\0"
   VALUE "ProductVersion", "0.3.0\0"
   VALUE "OriginalFilename", "MacSpaceSniffer.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
